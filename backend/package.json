    "express-async-errors": "3.1.1",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.1",
    "sharp": "0.33.5",
    "uuid": "10.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.6",
    "@types/multer": "1.4.12",
    "@types/node": "20.16.11",
    "@types/uuid": "10.0.0",
