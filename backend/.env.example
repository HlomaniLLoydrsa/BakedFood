# ── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# SQLite file (default — no setup needed)
DATABASE_URL="file:./dev.db"

# ── PRODUCTION (Turso) ────────────────────────────────────────────────────────
# Get these from turso.tech after creating a database:
#   turso db create droply
#   turso db show droply --url       → paste as DATABASE_URL
#   turso db tokens create droply    → paste as TURSO_AUTH_TOKEN
#
# DATABASE_URL="libsql://droply-yourname.turso.io"
# TURSO_AUTH_TOKEN="your-token-here"

# JWT
JWT_SECRET="change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# File Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Admin secret code
ADMIN_CODE="droply2024"

# ── CLOUDINARY (production file storage) ─────────────────────────────────────
# Sign up free at cloudinary.com → Dashboard → copy these 3 values
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
